{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweet-block-3530",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/partnership-enquiry",
      "/partnership-enquiry/config"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/enquiries.mjs",
  "ratelimits": [
    {
      "name": "ENQUIRY_RATE_LIMITER",
      "namespace_id": "75430691",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "ENQUIRY_GLOBAL_LIMITER",
      "namespace_id": "75430692",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "keep_vars": true
}
